{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOBS SQL Editor",
  "version": "1.0.4",
  "identifier": "ch.monsama.nobssqleditor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NOBS SQL Editor",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "minWidth": 1100,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}